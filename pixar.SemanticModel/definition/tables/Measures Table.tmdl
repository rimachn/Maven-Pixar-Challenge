		lineageTag: 5ee53afc-6772-4a4d-b5f4-a0b7a1445a73

	measure 'Dynamic rating slicer selection (Y axis)' =
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('Rating Slicer'[Value1]) = "IMDB",[Highest IMDB score],
			    SELECTEDVALUE('Rating Slicer'[Value1]) = "Rotten Tomatoes",[Highest Rotten_Tomatoes score],
			    SELECTEDVALUE('Rating Slicer'[Value1]) = "MetaCritic",[Highest Metacritic score]
			)
		formatString: 0.00
		lineageTag: 62766a0c-802f-4157-bafa-55e6ddc03fd3

	measure 'Dynamic Review slicer selection ( Y axis)' =
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('Rating Slicer'[Value1]) = "IMDB", [Highest IMDB Count],
			    SELECTEDVALUE('Rating Slicer'[Value1]) = "Rotten Tomatoes",[Highest Rotten_Tomatoes Count],
			    SELECTEDVALUE('Rating Slicer'[Value1]) = "MetaCritic",[Highest Metacritic count],
			    SELECTEDVALUE('Rating Slicer'[Value1]) = "Cinema",[Highest Cinema score count]
			)
		formatString: #,0
		lineageTag: da5472d7-13bb-4085-9f69-4394c45c156d

	measure 'Dynamic tooltip' =
			
