		lineageTag: b541e314-c472-4d21-8ae7-d0fd1adbefc8

	measure PeopleRole = ```
			
			CONCATENATEX(
			    pixar_people,
			    RELATED(
			        people_details[People_name]) & " (" & RELATED(role[role_type]) & ") ",
			        " ,",
			        RELATED(pixar_films[release_date]),
			        ASC
			    
			)
			```
		lineageTag: 1b631fe3-0e1f-4cfe-b772-dec12907922e

	measure 'Highest IMDB score (Film Name)' = ```
			
			Var Highest_IMDB_Score = 
			MAXX(
			    FILTER(
			        public_response_data,
			        RELATED(public_response[Critic_score_review]) = "imdb_score"
			    ),
			    public_response_data[Critic_score_review_Value]
			)
			
			
			
			Var FilmNames= 
			CONCATENATEX(
			    FILTER(
			        public_response_data,
			        public_response_data[Critic_score_review_Value] = Highest_IMDB_Score 
			    ),
			    RELATED(pixar_films[film]) ,
			    ", "
			)
			
			RETURN FilmNames
			```
		lineageTag: 42f7f3d4-925c-4f96-9619-e082f2f1c2e4

	measure 'Highest Metacritic score ( film Name)' = ```
			
			 Var HighestMetacriticScore =
			MAXX( 
			    --"metacritic_score"
			    FILTER(
			        public_response_data,
			        RELATED(public_response[Critic_score_review]) = "metacritic_score"
			        ),
			        public_response_data[Critic_score_review_Value]
			)
			
			VAR FilmName =
			CONCATENATEX(
			    FILTER(
			        public_response_data,
			        public_response_data[Critic_score_review_Value] = HighestMetacriticScore
			    ),
			    RELATED(pixar_films[film]),
			    ", "
			)
			
			RETURN FilmName
			
			```
		lineageTag: 3d51363f-0b33-4866-8840-e5c018681a2a

	measure 'Highest Rotten_Tomatoes score (Film Name )' = ```
			
			 VAR highestRottenTomatoesScore =
			MAXX(
			    -- Rotten_tomatoes_score
			    FILTER(
			        public_response_data,
			        RELATED(public_response[Critic_score_review]) = "Rotten_tomatoes_score"
			        ),
			    public_response_data[Critic_score_review_Value]
			)
			
			VAR FilmName = 
			CONCATENATEX(
			    FILTER(
			        public_response_data,
			        public_response_data[Critic_score_review_Value] = highestRottenTomatoesScore
			    ),
			    RELATED(pixar_films[film]),
			    ", "
			    )
			
			RETURN FilmName
			```
		lineageTag: bbf10919-481c-42d8-8a17-c63040300df6

	measure 'Highest Cinema score count' =
			
