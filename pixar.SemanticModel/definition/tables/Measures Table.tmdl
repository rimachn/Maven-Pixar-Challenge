	measure 'Profit %' = ```
			
			    DIVIDE(
			        [Box_office_worldwide],
			        [Budget],
			        0
			    )
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: fe3cb666-0959-4984-9d01-c89377ba5eb1

	measure Budget = ```
			
			  CALCULATE(
			    SUM(
			        Box_Office_data[Box_Office_amount]
			        ),
			    FILTER(
			        box_office, 
			        box_office[box_office] = "Budget"
			    )
