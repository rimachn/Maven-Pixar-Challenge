	measure 'Count films by Genre Type' = ```
			
			CALCULATE(
			    COUNT(genres_data[film_number]),
			        RELATEDTABLE(pixar_films)
			    
			)
			```
		formatString: 0
		lineageTag: ce606ddd-32be-449e-9ed8-091d343e41b3

	measure 'Film Names (Award Won)' = ```
			
			CONCATENATEX( 
			    FILTER(
			        academy_data,
			        (
			            RELATED(academy_award_status[status])= "Won" || RELATED(academy_award_status[status] )= "Won Special Achievement")
			        ),
			    RELATED(pixar_films[film]),
			    ", "
			)
			```
		lineageTag: a761a3d7-c164-4156-8eb0-f564597f3ea2

	measure 'Film Names (Nominated)' = ```
			
			CONCATENATEX( 
			    FILTER(
			        academy_data,
			        (
			            RELATED(academy_award_status[status])= "Nominated" 
			        )
			    ),
			    RELATED(pixar_films[film]),
			    ", "
			)
			
			```
		lineageTag: 3fcc6ed0-6761-4cc8-a7ee-eb51deefd371

	measure 'Film Name(by People and their role)' = ```
			
			CONCATENATEX(
			    pixar_people,
			    RELATED(pixar_films[film]) & " (" & RELATED(role[role_type]) & ") ",
			    ", ",
			    RELATED(pixar_films[release_date]),
			    ASC
			        
			)
			```
		lineageTag: 25e1e5ec-c7e0-4176-b4ee-c5dc71798a4d

	measure 'Films Genre' = ```
			
			CONCATENATEX(
			    FILTER(
			       genres_data,
			       RELATED(genres_type[Category Name]) = "Genre"
			
			    ),
			    RELATED(genres_type[genre_type]),
			    ","
			)
			    
			```
		lineageTag: 4b353b9a-9fbd-4c9a-b8ea-2d27c1195041

	measure 'Films Sub-Genre' =
			
