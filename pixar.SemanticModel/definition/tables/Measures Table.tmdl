	measure 'Total Awards Won count' = ```
			
			CALCULATE(
			    COUNT(
			        academy_data[award_Id]
			        ),
			        FILTER(
			            academy_award_status, 
			            academy_award_status[status] = "Won" || academy_award_status[status] = "Won Special Achievement"
			        )
			)
			```
		formatString: 0
		lineageTag: 43156dfe-129a-4a79-9670-5c0d4450c723

	measure 'Won Special Achievement count' = ```
			
			CALCULATE(
			    COUNT(
			        academy_data[award_Id]
			    ),
			    FILTER(
			        academy_award_status, 
			        academy_award_status[status] = "Won Special Achievement"
			    )
			)
			```
		formatString: 0
		lineageTag: 6790ccb1-7877-4173-94de-6506d23e5c9f

	measure 'Award Nominated count' = ```
			
			VAR nominated =
			CALCULATE(
			    COUNT(
			        academy_data[award_Id] 
			    ),
			    FILTER(
			        academy_award_status,
			        academy_award_status[status] = "Nominated"
			    )
			)
			
			RETURN nominated + [Total Awards Won count]
			```
		formatString: 0
		lineageTag: c69506b5-fa44-4088-904d-5d0838fb8dab

